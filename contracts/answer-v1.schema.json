{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.invalid/contracts/answer.v1.json",
  "title": "MOSAIC AnswerEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "outcome", "answer", "evidence_ids", "links"],
  "properties": {
    "contract_version": { "const": "answer.v1" },
    "outcome": { "type": "string", "enum": ["answer", "refuse", "fallback"] },
    "answer": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "evidence_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^e[1-9][0-9]{0,5}$" }
    },
    "links": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 160 },
          "href": { "type": "string", "pattern": "^/", "maxLength": 300 }
        }
      }
    }
  }
}
